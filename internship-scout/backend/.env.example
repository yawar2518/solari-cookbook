# ---- Required -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
SOLARI_API_KEY=slr_live_...

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (server only, never ship to a browser). No text after the value!
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Access control -----------------------------------------------------
# Comma-separated. These emails get /admin regardless of the DB flag.
ADMIN_EMAILS=your_email@example.com

# Optional shared secret. If set, every request must carry X-Internal-Secret.
# Set the same value as INTERNAL_API_SECRET in the frontend so only the
# Next.js server can call this API.
INTERNAL_API_SECRET=

# Origins allowed by CORS (the Next.js server). Comma-separated.
CORS_ORIGINS=http://localhost:3000

# ---- Tuning (defaults shown) --------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-6
JOB_CACHE_TTL_HOURS=6
JOB_DETAILS_TTL_DAYS=7
COMPANY_RESEARCH_TTL_DAYS=7
FREE_SEARCHES_PER_DAY=3
FREE_COVER_LETTERS_PER_DAY=3
SCRAPE_TIMEOUT_SECONDS=300

# List prices used only for the admin cost chart (USD per million tokens)
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0
